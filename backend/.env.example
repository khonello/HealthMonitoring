SECRET_KEY=your-django-secret-key-here
DEBUG=True

# Database (PostgreSQL — required in every environment)
# DB_NAME and DB_USER match the role and database created in docs/database-setup.md.
DB_NAME=healthmonitoring
DB_USER=healthmonitor
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Django settings module — NOT read from this file. Setting it here has no effect.
# manage.py, wsgi.py and asgi.py select the module via os.environ.setdefault before
# Django loads settings, and load_dotenv() only runs inside development.py — so any
# value here always arrives too late. To actually switch environments, export the real
# environment variable, or pass --settings=configs.settings.production per command.
# DJANGO_SETTINGS_MODULE=configs.settings.development

# CORS (comma-separated, production only)
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Allowed hosts (comma-separated, production only)
ALLOWED_HOSTS=localhost,127.0.0.1
